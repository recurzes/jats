# Copy to web/.env and fill in. Only public values: Vite bakes every VITE_* variable into the
# bundle that anyone can download. Never put the Supabase service-role key or any secret here.

# FastAPI base URL
VITE_API_URL=http://localhost:8000
# Your Supabase project URL
VITE_SUPABASE_URL=https://your-project.supabase.co
# Supabase anon (public) key, used only for login
VITE_SUPABASE_ANON_KEY=your-anon-key
# true to run against MSW mock data
VITE_USE_MOCKS=true
