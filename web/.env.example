# Copy to web/.env and fill in. Only public values: Vite bakes every VITE_* variable into the
# bundle that anyone can download. Never put a secret here.

# FastAPI base URL
VITE_API_URL=http://localhost:8000
# Neon Auth URL (Neon console > Auth > Configuration), used only for login. The same value as the
# API's NEON_AUTH_BASE_URL. Add the web app's origin to Neon Auth's trusted domains.
VITE_NEON_AUTH_URL=https://ep-example.neonauth.region.aws.neon.tech/neondb/auth
# true to run against MSW mock data
VITE_USE_MOCKS=true
