# Copy to api/.env and fill in. Never commit real values.

# Local value matches docker-compose.yml (host port 5433).
# Production: the Neon *direct* connection string, with the scheme changed to
# postgresql+psycopg://. Not the pooled one (host contains -pooler): it breaks advisory locks.
DATABASE_URL=postgresql+psycopg://jats:jats@localhost:5433/jats

# development | production
ENVIRONMENT=development

# Neon Auth URL (Neon console > Auth > Configuration). Tokens from the web app are checked
# against its public signing keys, at <NEON_AUTH_BASE_URL>/.well-known/jwks.json.
# While it is empty the API refuses every token.
NEON_AUTH_BASE_URL=https://ep-example.neonauth.region.aws.neon.tech/neondb/auth

# Your Neon Auth user id (Neon console > Auth > Users). Only this user gets past the API's login
# check, and it owns every device. The placeholder locks everyone out.
OWNER_USER_ID=00000000-0000-0000-0000-000000000001

# Comma-separated browser origins allowed to call the API: the React dev server, plus the
# production web origin once it exists.
CORS_ORIGINS=http://localhost:5173

# Fernet key that encrypts the Gmail refresh token in the database. Generate one with:
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Changing it makes the stored token unreadable, so Gmail has to be connected again.
TOKEN_ENC_KEY=

# Signs the state value of the Gmail connect flow. Generate one with:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
STATE_SECRET=

# Google Cloud console > APIs & Services > Credentials > the Web OAuth client.
# The redirect URI must match one of the client's authorised redirect URIs exactly.
# Publish the consent screen (it stays unverified): an app left in Testing loses its refresh
# token after 7 days.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# The web app. The Google callback redirects here with ?gmail=connected or ?gmail=error.
FRONTEND_URL=http://localhost:5173

# Minutes between Gmail syncs.
SYNC_INTERVAL_MINUTES=5
# false turns the in-process scheduler off; POST /sync still works.
SCHEDULER_ENABLED=true

# The AI provider that classifies emails: any OpenAI-compatible API. Swap providers by
# changing these three. An empty base URL means OpenAI itself.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
# Seconds to wait for one answer. A timeout is retried once.
LLM_TIMEOUT_SECONDS=30

# A classification less confident than this (0 to 1) is flagged for review and not printed.
REVIEW_THRESHOLD=0.6
# AI calls one sync may make; the rest wait for the next sync. Keeps the first sync, which
# reads 7 days of mail, from running up a bill. 0 turns classification off.
MAX_CLASSIFICATIONS_PER_RUN=30

# Sentry project DSN (Sentry > Project settings > Client keys). Errors are reported without
# request headers, bodies or local variables. Empty turns Sentry off.
SENTRY_DSN=

# Characters per receipt line: 32 for 58 mm paper.
RECEIPT_WIDTH=32

# A claimed print job returns to the queue after this many seconds without an ack.
LEASE_SECONDS=60
# A print job is marked failed after this many claims.
MAX_ATTEMPTS=5
