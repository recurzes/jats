# Copy to api/.env and fill in. Never commit real values.

# Local value matches docker-compose.yml (host port 5433).
# Production: the Supabase *session pooler* string (port 5432), with the scheme changed to
# postgresql+psycopg://. Not the transaction pooler (port 6543): it breaks advisory locks.
DATABASE_URL=postgresql+psycopg://jats:jats@localhost:5433/jats

# development | production
ENVIRONMENT=development

# Owner of every device. A placeholder uuid until web auth exists.
OWNER_USER_ID=00000000-0000-0000-0000-000000000001

# Characters per receipt line: 32 for 58 mm paper.
RECEIPT_WIDTH=32

# A claimed print job returns to the queue after this many seconds without an ack.
LEASE_SECONDS=60
# A print job is marked failed after this many claims.
MAX_ATTEMPTS=5
