# Copy to api/.env and fill in. Never commit real values.

# Local value matches docker-compose.yml (host port 5433).
# Production: the Neon *direct* connection string, with the scheme changed to
# postgresql+psycopg://. Not the pooled one (host contains -pooler): it breaks advisory locks.
DATABASE_URL=postgresql+psycopg://jats:jats@localhost:5433/jats

# development | production
ENVIRONMENT=development

# Neon Auth URL (Neon console > Auth > Configuration). Tokens from the web app are checked
# against its public signing keys, at <NEON_AUTH_BASE_URL>/.well-known/jwks.json.
# While it is empty the API refuses every token.
NEON_AUTH_BASE_URL=https://ep-example.neonauth.region.aws.neon.tech/neondb/auth

# Your Neon Auth user id (Neon console > Auth > Users). Only this user gets past the API's login
# check, and it owns every device. The placeholder locks everyone out.
OWNER_USER_ID=00000000-0000-0000-0000-000000000001

# Comma-separated browser origins allowed to call the API: the React dev server, plus the
# production web origin once it exists.
CORS_ORIGINS=http://localhost:5173

# Characters per receipt line: 32 for 58 mm paper.
RECEIPT_WIDTH=32

# A claimed print job returns to the queue after this many seconds without an ack.
LEASE_SECONDS=60
# A print job is marked failed after this many claims.
MAX_ATTEMPTS=5
