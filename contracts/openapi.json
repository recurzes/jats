{
  "openapi": "3.1.0",
  "info": {
    "title": "Jats API",
    "description": "\nThree kinds of caller:\n\n- **The web app** sends a Neon Auth token as `Authorization: Bearer <token>`. Only the owner's\n  token is accepted.\n- **The ESP32** sends its device key as `X-Device-Key`, and can only call the `/device` routes.\n- **Anyone** can call `/health`. Google sends the browser to `/auth/google/callback`.\n\nEvery error has the same body, `{\"error\": {\"code\": \"...\", \"message\": \"...\"}}`. Branch on `code`;\n`message` is for a person to read.\n",
    "version": "0.1.0"
  },
  "paths": {
    "/applications": {
      "get": {
        "tags": [
          "applications"
        ],
        "summary": "List applications",
        "description": "The board's cards, the most recently changed first.",
        "operationId": "list_applications_applications_get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/Status"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Only applications with this status.",
              "title": "Status"
            },
            "description": "Only applications with this status."
          },
          {
            "name": "needs_review",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Only applications that are, or are not, flagged for review.",
              "title": "Needs Review"
            },
            "description": "Only applications that are, or are not, flagged for review."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ApplicationSummary"
                  },
                  "title": "Response List Applications Applications Get"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "The token is valid, but its user is not the owner",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "The request is not valid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
