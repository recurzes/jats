  "components": {
    "schemas": {
      "ApplicationDetail": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "company": {
            "type": "string",
            "title": "Company"
          },
          "role": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Role"
          },
          "status": {
            "$ref": "#/components/schemas/Status"
          },
          "needs_review": {
            "type": "boolean",
            "title": "Needs Review"
          },
          "last_event_at": {
            "type": "string",
            "format": "date-time",
            "title": "Last Event At"
          },
          "last_email_subject": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Email Subject"
          },
          "last_email_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Email At"
          },
          "first_seen_at": {
            "type": "string",
            "format": "date-time",
            "title": "First Seen At"
          },
          "emails": {
            "items": {
              "$ref": "#/components/schemas/EmailSummary"
            },
            "type": "array",
            "title": "Emails"
          },
          "status_events": {
            "items": {
              "$ref": "#/components/schemas/StatusEventOut"
            },
            "type": "array",
            "title": "Status Events"
          }
        },
        "type": "object",
        "required": [
          "id",
          "company",
          "role",
          "status",
          "needs_review",
          "last_event_at",
          "last_email_subject",
          "last_email_at",
          "first_seen_at",
          "emails",
          "status_events"
        ],
        "title": "ApplicationDetail",
        "description": "One card with what the detail panel shows. Emails and events are newest first."
      },
      "ApplicationPatch": {
        "properties": {
          "status": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Status"
              },
              {
                "type": "null"
              }
            ]
          },
          "company": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Company"
          },
          "role": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ],
            "title": "Role"
          },
          "needs_review": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Needs Review"
          }
