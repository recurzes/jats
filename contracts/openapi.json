    "/auth/google/callback": {
      "get": {
        "tags": [
          "gmail"
        ],
        "summary": "Finish connecting Gmail",
        "description": "Public: Google sends the browser here, so the signed state is the only protection.\n\nThe browser is mid-navigation, so every failure goes back to the web app instead of\nanswering with a JSON error.",
        "operationId": "callback_auth_google_callback_get",
        "parameters": [
          {
            "name": "code",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Code"
            }
          },
          {
            "name": "state",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
